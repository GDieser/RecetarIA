<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvNombreReceta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/gris_plomo"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Nombre de la Receta" />

        <TextView
            android:id="@+id/tvTiempo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableTop="@drawable/ic_clock"
            android:drawablePadding="4dp"
            android:drawableTint="@color/primario"
            android:gravity="center"
            android:textColor="@color/gris_plomo"
            android:textSize="11sp"
            tools:text="45 min" />

        <TextView
            android:id="@+id/tvDificultad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableTop="@drawable/ic_hardnees"
            android:drawablePadding="4dp"
            android:drawableTint="@color/primario"
            android:gravity="center"
            android:textColor="@color/gris_plomo"
            android:textSize="11sp"
            tools:text="Intermedio" />

        <TextView
            android:id="@+id/tvTipoComida"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableTop="@drawable/ic_tipo_comida"
            android:drawablePadding="4dp"
            android:drawableTint="@color/primario"
            android:gravity="center"
            android:textColor="@color/gris_plomo"
            android:textSize="11sp"
            tools:text="Cena" />

        <TextView
            android:id="@+id/tvComensales"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableTop="@drawable/ic_people"
            android:drawablePadding="4dp"
            android:drawableTint="@color/primario"
            android:gravity="center"
            android:textColor="@color/gris_plomo"
            android:textSize="11sp"
            tools:text="4 pers." />

        <androidx.constraintlayout.helper.widget.Flow
            android:id="@+id/flowInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:constraint_referenced_ids="tvTiempo,tvDificultad,tvTipoComida,tvComensales"
            app:flow_horizontalGap="8dp"
            app:flow_verticalGap="8dp"
            app:flow_wrapMode="chain"
            app:flow_horizontalStyle="spread"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvNombreReceta" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>