<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvNombreReceta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/nombre_de_la_receta"
            android:textColor="@color/gris_plomo"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvDescripcionCorta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/primario"
            android:textSize="14sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Tu descripción larga aqui..."
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvNombreReceta" />

        <TextView
            android:id="@+id/tvTiempo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_info"
            android:drawableStart="@drawable/ic_clock"
            android:drawablePadding="8dp"
            android:drawableTint="@color/primario"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="45 min"
            android:textColor="@color/gris_plomo"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvDificultad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_info"
            android:drawableStart="@drawable/ic_hardnees"
            android:drawablePadding="8dp"
            android:drawableTint="@color/primario"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="Intermedio"
            android:textColor="@color/gris_plomo"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvComensales"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_info"
            android:drawableStart="@drawable/ic_people"
            android:drawablePadding="8dp"
            android:drawableTint="@color/primario"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="4 pers."
            android:textColor="@color/gris_plomo"
            android:textSize="12sp" />

        <androidx.constraintlayout.helper.widget.Flow
            android:id="@+id/flowInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:constraint_referenced_ids="tvTiempo,tvDificultad,tvComensales"
            app:flow_horizontalGap="8dp"
            app:flow_verticalGap="8dp"
            app:flow_wrapMode="chain"
            app:flow_horizontalStyle="packed"
            app:flow_horizontalBias="0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDescripcionCorta" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>